# ─────────────────────────────────────────────────────────────
# VIGENT 비밀키 예시 파일
#
# 사용법:
#   1) 이 파일을 복사해서 .env 로 만든다:   cp .env.example .env
#   2) .env 에 실제 값을 채운다(아래 빈칸).
#   3) .env 는 .gitignore 로 제외되어 git 에 올라가지 않는다(규칙 5).
#
# ⚠ 실제 토큰/키는 절대 .env.example 이나 코드/채팅에 쓰지 말 것.
# ─────────────────────────────────────────────────────────────

# 텔레그램 봇 경보 (Dispatcher)
#  - BotFather 로 봇 생성 후 받은 토큰
TELEGRAM_BOT_TOKEN=
#  - 경보를 받을 채팅/채널 ID
TELEGRAM_CHAT_ID=

# 범용 웹훅 경보 (Dispatcher) — Slack/Discord/사내 시스템 등
WEBHOOK_URL=

# ── LLM (텍스트 보강) ──────────────────────────────────────────
# 프로바이더 선택: openai(기본) | anthropic
#   ※ 2026-07-14: ollama(로컬) 경로 제거 → OpenAI 단일화. anthropic 은 마이그레이션 대비 유지.
#   ※ 키가 없거나 API 장애여도 기능은 죽지 않는다 → 규칙 기반 폴백(절대 저하 없음).
#      LLM 은 '종합의견' 한 문단에만 opt-in 으로 쓰이며, 위험성평가서의 점검항목·법령·위계는 전부 규칙 기반.
VIGENT_LLM_PROVIDER=openai

# OpenAI (VIGENT_LLM_PROVIDER=openai 일 때)
OPENAI_API_KEY=
#  - 텍스트 모델(미설정 시 gpt-4o-mini)
OPENAI_MODEL=

# Anthropic / Claude (VIGENT_LLM_PROVIDER=anthropic 일 때)
ANTHROPIC_API_KEY=

# ── 비전(현장 프레임) 외부 전송 게이트 — F-12 ────────────────────
# ★ 영상 현장 외 불유출 원칙: 아래를 1 로 명시하지 않으면 프레임은 절대 클라우드로 나가지 않는다.
#   OPENAI_API_KEY 가 있어도 마찬가지(키만으로는 전송 안 함). 상용 배포 미포함 — 데모/내부개발 전용.
# VIGENT_CLOUD_VLM=1
#  - 비전 모델(미설정 시 OPENAI_MODEL → gpt-4o-mini)
OPENAI_VISION_MODEL=
