# ── 비밀키·환경변수 (규칙 5) ──
.env
.env.*
# 예시 파일은 git 에 포함(실제 키 없음)
!.env.example
config/notify.yaml

# ── 모델 가중치 (용량 큼 — git 제외, 필요시 Git LFS) ──
*.pt
*.keras
*.onnx
*.tflite
*.h5
vigent-core/weights/

# ── 데이터셋·산출물 ──
data/
runs/

# ── 파이썬 캐시·가상환경 ──
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# ── OS·에디터 ──
.DS_Store
.idea/
.vscode/
bin/
config/site.yaml

# 로컬 번들 자산(다운로드로 재생성: bin/download-vendor.sh)
vigent-core/static/vendor/

# C-S1 런타임 로그(로테이션)
logs/

# ── 사본·아카이브 (저장소 밖 관리, 커밋 금지) ──
VIGENT_archive/
VIGENT USB/
vigent-landing 2/
vigentFacialRecognition/
VIGENT_artifacts/
# 일회성 의존성 스냅샷(재생성 가능 — pip freeze). 디스크 보존, 추적만 해제(P2-15)
backup/
# ── 개인 실행/메모 (데스크탑 한글 .command/.md) ──
/VIGENT *.command
/VIGENT *.md
# ── 벤치 산출물(대용량 바이너리 — 근거는 FINDINGS 텍스트로 인용) ──
benchmarks/results/
# ── 검증용 원본 영상(대용량 바이너리 — 커밋 금지, 로컬 관리). B4 rig_monitor 검증 등 ──
footage/
# ── 사업 문서 (새 개발자 비공개, 저장소 밖 관리) ──
/VIGENT_사업추진계획서*.md
business_assets/
pilot_*.md
vigent_helios_hx_deployable.html
